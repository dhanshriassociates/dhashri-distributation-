# ========================================================
# SUPABASE CONFIGURATION TEMPLATE
# Copy this file to .env and insert your project credentials
# DO NOT commit real keys to version control (Git)
# ========================================================

# Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous / Publishable Key
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
